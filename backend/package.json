{
  "name": "aura-jkn-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AURA-JKN Backend Service (Next.js API Routes + Prisma ORM + PostgreSQL + Python R-GCN Bridge)",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:backend": "next dev -p 3001",
    "dev:frontend": "npm --prefix ../frontend run dev",
    "build": "next build",
    "start": "next start -p 3001",
    "db:start": "node node_modules/tsx/dist/cli.mjs start_postgres.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:policy": "node node_modules/tsx/dist/cli.mjs test_zero_mock_policy.ts",
    "test:master": "node node_modules/tsx/dist/cli.mjs test_master_verification.ts",
    "test:acceptance": "node node_modules/tsx/dist/cli.mjs test_final_acceptance.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
