# ==============================================================================
# AURA-JKN Environment Configuration
# ==============================================================================

# PostgreSQL Credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aura_jkn

# Full Database Connection URL (Optional - if left empty, will be built from above)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aura_jkn

PORT=8000
ENVIRONMENT=development

# ==============================================================================
# Generative AI Layer (GroqCloud & NVIDIA NIM)
# ==============================================================================
GROQ_API_KEY=gsk_...
NVIDIA_API_KEY=nvapi-...
GROQ_MODEL=auto
NVIDIA_MODEL=auto
LLM_TIMEOUT=3.0
