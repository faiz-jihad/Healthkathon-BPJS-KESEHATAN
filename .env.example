# ==============================================================================
# AURA-JKN: UNIFIED ENVIRONMENT CONFIGURATION (DOCKER COMPOSE / BACKEND / AI)
# ==============================================================================

# 1. PostgreSQL Database Configuration
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura_jkn_db
POSTGRES_HOST_PORT=5433
DATABASE_URL="postgresql://aura_user:aura_password@postgres:5432/aura_jkn_db?schema=public"
DB_USER=aura_user
DB_PASSWORD=aura_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aura_jkn_db

# 2. Security & Authentication (HMAC-SHA256 Token Vault)
AUTH_SECRET="aura-jkn-production-auth-secret-healthkathon-2026-bpjs-secure-token-vault"

# 3. Service Ports & Internal Endpoints
PORT=3001
AI_SERVICE_URL="http://ai-service:8000"
FRONTEND_PORT=5173
HTTP_PORT=80
VITE_BACKEND_URL="http://localhost:3001"

# 4. Generative AI Layer (GroqCloud Primary & NVIDIA NIM Secondary)
# Isi GROQ_API_KEY & NVIDIA_API_KEY milik Lesmana/Tim di bawah ini:
GROQ_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL=auto
NVIDIA_MODEL=auto
LLM_TIMEOUT=3.0
