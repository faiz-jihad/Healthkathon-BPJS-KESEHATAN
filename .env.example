# =================================================================
# AURA-JKN: PRODUCTION ENVIRONMENT CONFIGURATION (VPS / DOCKER)
# =================================================================

# PostgreSQL Authoritative Database Settings
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura_jkn_db

# JWT & HMAC Authentication Secret (Min 32 random characters)
AUTH_SECRET=aura-jkn-production-auth-secret-healthkathon-2026-bpjs-secure-token-vault

# Internal Microservices Ports
PORT=3001
AI_SERVICE_URL=http://ai-service:8000

# Public Exposed Ports
FRONTEND_PORT=5173
HTTP_PORT=80

# Generative AI Layer (GroqCloud & NVIDIA NIM — Optional, falls back to Local Rule Engine if empty)
GROQ_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL=auto
NVIDIA_MODEL=auto
LLM_TIMEOUT=3.0
