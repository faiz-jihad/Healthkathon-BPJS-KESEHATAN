{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "AURA-JKN",
  "version": "1.0.0",
  "identifier": "id.my.mataceria.hackathon.aurajkn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AURA-JKN: Sistem Skrining Pra-Pembayaran BPJS",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "id-ID"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "displayLanguageSelector": false
      }
    }
  }
}
